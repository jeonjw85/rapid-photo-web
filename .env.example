# Local build, or use the published image jeonjw/rapid-photo-web:latest.
IMAGE=rapid-photo-web:local
IMAGE_VERSION=0.1.0
WEB_PORT=5800

# On Linux/NAS, match the owner of your writable folders: id -u / id -g.
USER_ID=1000
GROUP_ID=1000
UMASK=0022
TZ=Etc/UTC
LANG=en_US.UTF-8
DISPLAY_WIDTH=1920
DISPLAY_HEIGHT=1080

CONFIG_DIR=./data/config
INPUT_DIR=./data/input
UPLOADS_DIR=./data/uploads
OUTPUT_DIR=./data/output
